<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/mvc
           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- 1. Enable Spring MVC Annotation-Driven Features -->
    <!-- This enables support for features like @Controller, @RequestMapping, @RequestParam,
         @ResponseBody, data binding, type conversion, validation, etc. -->
    <mvc:annotation-driven/>

    <!-- 2. Component Scanning for Web/Controller Layer -->
    <!-- Scans the specified base package for Spring MVC components, primarily @Controller classes. -->
    <context:component-scan base-package="com.example.hrms.controller"/>

    <!-- 3. Configure ViewResolver for JSPs -->
    <!-- Resolves logical view names returned by controllers to actual JSP files. -->
    <bean id="viewResolver" class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <!-- Prefix prepended to view names. JSPs are located in /WEB-INF/jsp/ -->
        <property name="prefix" value="/WEB-INF/jsp/"/>
        <!-- Suffix appended to view names. Assumes .jsp extension. -->
        <property name="suffix" value=".jsp"/>
    </bean>

    <!-- 4. Static Resource Handling -->
    <!-- Configures Spring MVC to serve static resources like CSS, JavaScript, and images directly. -->
    <!-- 'mapping' attribute specifies the URL pattern. -->
    <!-- 'location' attribute specifies the directory within the web application root where these resources are located. -->
    <!-- Example: A request to /HRMS_SSM/css/style.css will be served from /webapp/css/style.css -->
    <mvc:resources mapping="/css/**" location="/css/"/>
    <mvc:resources mapping="/js/**" location="/js/"/>      <!-- If you add a js folder -->
    <mvc:resources mapping="/images/**" location="/images/"/> <!-- If you add an images folder -->

    <!--
        Additional MVC configurations can be added here later, such as:
        - Interceptors (for pre/post-processing requests)
        - Message converters (for handling JSON/XML request/response bodies)
        - Custom Exception resolvers (for global error handling)
        - File upload configuration (MultipartResolver)
    -->

</beans>
