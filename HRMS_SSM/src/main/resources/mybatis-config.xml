<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <!--
        Settings can be configured here, e.g.:
        <settings>
            <setting name="mapUnderscoreToCamelCase" value="true"/>
            <setting name="useGeneratedKeys" value="true"/>
        </settings>
    -->

    <!--
        Type aliases can be defined here to use short names for your model classes in mapper XMLs.
        For example:
        <typeAliases>
            <package name="com.example.hrms.model"/>
        </typeAliases>
    -->

    <!-- No environments needed here as Spring manages the DataSource and transactions -->

    <!-- Mappers will be configured in Spring (applicationContext.xml) via MapperScannerConfigurer -->
    <!-- or can be listed here if not using MapperScannerConfigurer extensively -->
</configuration>
