        VALUES (#{username}, #{password})
    </insert>

    <select id="findUserById" resultType="com.example.hrms.model.User">
        SELECT id, username, password FROM users WHERE id = #{id}
    </select>

    <select id="findAllUsers" resultType="com.example.hrms.model.User">
        SELECT id, username, password FROM users
    </select>
    -->
</mapper>
